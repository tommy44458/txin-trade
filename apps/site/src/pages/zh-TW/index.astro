---
import Base from "../../layouts/Base.astro";
import Home from "../../components/Home.astro";
import { homeStructuredData } from "../../seo";
import { t } from "../../i18n";
const locale = "zh-TW";
const text = t(locale).home;
---
<Base locale={locale} title={text.title} description={text.description} structuredData={homeStructuredData(locale)}>
  <Home locale={locale} />
</Base>
