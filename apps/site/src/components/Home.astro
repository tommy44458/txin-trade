---
import { t } from "../i18n";
import { RELEASED, REPOSITORY, downloadLink, localePath, type Locale } from "../site";

interface Props { locale: Locale }
const { locale } = Astro.props;
const text = t(locale).home;
const download = RELEASED ? downloadLink("mac", "home", locale) : localePath("/download", locale);

// The headline rises word by word; the two product names carry the logo's shine.
const names = /(ChatGPT|Claude)/;
const segmenter = new Intl.Segmenter(locale, { granularity: "word" });
const words = text.heroTitle.split(names).flatMap((part) =>
  names.test(part)
    ? [{ text: part, shine: true }]
    : [...segmenter.segment(part)].map((piece) => ({ text: piece.segment, shine: false })),
).filter((word) => word.text.length);
---
<section class="hero">
  <div class="glow" aria-hidden="true"></div>
  <a class="open-source fade" style="--d:0s" href={REPOSITORY} aria-label={text.openSourceLabel}>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
    <span>{text.openSource}</span>
    <span class="open-source-arrow" aria-hidden="true">→</span>
  </a>
  <h1 class="wrap" aria-label={text.heroTitle}>
    {words.map((word, index) => (
      word.text.trim()
        ? <span class="word" aria-hidden="true" style={`--i:${index}`}><span class={word.shine ? "shine" : undefined}>{word.text}</span></span>
        : <span aria-hidden="true">{word.text}</span>
    ))}
  </h1>
  <p class="lead wrap fade" style="--d:0.35s">{text.heroSubtitle}</p>
  <div class="actions fade" style="--d:0.5s">
    <a class="button" href={download} data-download
      data-windows-href={downloadLink("windows", "home", locale)} data-windows-label={text.downloadWindows}>{RELEASED ? text.download : text.comingSoon}</a>
    <a class="button secondary" href={REPOSITORY} target="_blank" rel="noopener">{text.github} <span class="arrow" aria-hidden="true">↗</span></a>
  </div>
  <p class="caption fade" style="--d:0.6s">
    <span data-caption data-windows-caption={text.captionWindows}>{text.caption}</span>
    {RELEASED && <>{" · "}<a href={localePath("/download", locale)} data-other data-windows-other={text.alsoMac}>{text.alsoWindows}</a></>}
  </p>
</section>

<section class="stage">
  <figure class="frame">
    <video data-video autoplay muted loop playsinline preload="metadata" poster="/video/promo-v7-16x9.webp"
      data-tall-src="/video/promo-v7-9x16.mp4" data-tall-poster="/video/promo-v7-9x16.webp"
      data-wide-src="/video/promo-v7-16x9.mp4" data-wide-poster="/video/promo-v7-16x9.webp"
      aria-label={text.videoLabel}>
      <source src="/video/promo-v7-9x16.mp4" type="video/mp4" media="(max-width: 700px)" />
      <source src="/video/promo-v7-16x9.mp4" type="video/mp4" />
    </video>
    <button type="button" class="toggle" data-toggle data-pause={text.pause} data-play={text.play} aria-label={text.pause}>
      <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="4" y="3" width="2.6" height="10" rx="1" /><rect x="9.4" y="3" width="2.6" height="10" rx="1" /></svg>
      <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.2v9.6a.8.8 0 0 0 1.2.7l7.6-4.8a.8.8 0 0 0 0-1.4L6.2 2.5A.8.8 0 0 0 5 3.2Z" /></svg>
    </button>
  </figure>
</section>

<ol class="points wrap">
  {text.points.map(([title, body], index) => (
    <li>
      <span class="index">{String(index + 1).padStart(2, "0")}</span>
      <strong>{title}</strong>
      <span>{body}</span>
    </li>
  ))}
</ol>

<section class="faq wrap" aria-labelledby="faq-title">
  <h2 id="faq-title">{text.faqTitle}</h2>
  <dl>
    {text.faq.map(([question, answer]) => (
      <div>
        <dt>{question}</dt>
        <dd>{answer}</dd>
      </div>
    ))}
  </dl>
</section>

<script>
  // The page is static and offers the Mac installer; Windows visitors get theirs.
  if (/Windows/.test(navigator.userAgent)) {
    const button = document.querySelector<HTMLAnchorElement>("[data-download]");
    const caption = document.querySelector<HTMLElement>("[data-caption]");
    const other = document.querySelector<HTMLElement>("[data-other]");
    if (button?.dataset.windowsHref && button.dataset.windowsLabel && caption?.dataset.windowsCaption) {
      button.href = button.dataset.windowsHref;
      button.textContent = button.dataset.windowsLabel;
      caption.textContent = caption.dataset.windowsCaption;
      if (other?.dataset.windowsOther) other.textContent = other.dataset.windowsOther;
    }
  }
  const video = document.querySelector<HTMLVideoElement>("[data-video]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-toggle]");
  if (video && toggle) {
    const sync = () => {
      const paused = video.paused;
      toggle.classList.toggle("paused", paused);
      toggle.setAttribute("aria-label", (paused ? toggle.dataset.play : toggle.dataset.pause) ?? "");
    };
    toggle.addEventListener("click", () => { if (video.paused) void video.play(); else video.pause(); });
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    // Respect reduced motion: start on a still frame; the button plays it.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      video.removeAttribute("autoplay");
      video.pause();
    }
    // Choose the film for the laid-out width, not the width at parse time: some
    // in-app browsers report a desktop width before applying the viewport, and
    // a <source media> choice is never revisited. Rotating a phone re-chooses.
    const tall = window.matchMedia("(max-width: 700px)");
    const choose = () => {
      const kind = tall.matches ? "tall" : "wide";
      const src = video.dataset[`${kind}Src`];
      const poster = video.dataset[`${kind}Poster`];
      if (!src || !poster) return;
      video.style.aspectRatio = tall.matches ? "9 / 16" : "16 / 9";
      if (video.poster !== new URL(poster, location.href).href) video.poster = poster;
      if (video.currentSrc && new URL(video.currentSrc).pathname === src) return;
      const playing = video.autoplay || !video.paused;
      video.src = src;
      video.load();
      if (playing) void video.play().catch(() => {});
    };
    // Whatever was loaded, the frame takes the film's own shape, so it is never cropped.
    video.addEventListener("loadedmetadata", () => {
      if (video.videoWidth && video.videoHeight)
        video.style.aspectRatio = `${video.videoWidth} / ${video.videoHeight}`;
    });
    tall.addEventListener("change", choose);
    choose();
    sync();
  }
</script>

<style>
  .hero { position: relative; padding: clamp(72px, 12vh, 140px) 0 0; text-align: center; }
  .glow {
    position: absolute; inset: -10% 0 auto; height: 900px; z-index: -1; pointer-events: none;
    background: radial-gradient(50% 45% at 50% 70%, var(--glow), transparent 70%);
  }
  h1 { font-size: clamp(40px, 7.4vw, 96px); line-height: 1.02; letter-spacing: -0.045em; max-width: 15ch; }
  /* CJK glyphs carry more visual weight: a smaller size and looser tracking balance the Latin names. */
  :global(html[lang="zh-Hant-TW"]) h1 { font-size: clamp(34px, 5.6vw, 76px); max-width: 12em; letter-spacing: -0.015em; line-height: 1.16; }
  .word { display: inline-block; animation: rise 1s var(--ease) both; animation-delay: calc(var(--i) * 45ms); }
  .shine {
    background: var(--shine); background-size: 200% 100%; -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: shine 6s ease-in-out 1.2s infinite;
  }
  /* The project's promise, first thing in the hero: free and open source, one tap to the code. */
  .open-source {
    position: relative; display: inline-flex; align-items: center; gap: 9px;
    margin: 0 auto 28px; padding: 8px 16px 8px 13px; border-radius: 999px;
    color: var(--text); font-size: 15px; font-weight: 500; letter-spacing: -0.01em;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    box-shadow: inset 0 0 0 1px var(--border), 0 8px 30px -12px var(--glow);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    transition: box-shadow 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .open-source::before {
    /* A thin moving highlight along the edge. */
    content: ""; position: absolute; inset: 0; padding: 1px; border-radius: inherit; pointer-events: none;
    background: linear-gradient(100deg, transparent 20%, var(--accent) 50%, transparent 80%) 0 0 / 250% 100%;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    animation: edge 5s ease-in-out 1.5s infinite;
  }
  .open-source svg { width: 17px; height: 17px; fill: currentColor; }
  .open-source-arrow { color: var(--text-secondary); transition: transform 0.35s var(--ease); }
  .open-source:hover { text-decoration: none; transform: translateY(-1px); box-shadow: inset 0 0 0 1px var(--text-tertiary), 0 10px 34px -12px var(--glow); }
  .open-source:hover .open-source-arrow { transform: translateX(3px); }
  @keyframes edge { 0%, 100% { background-position: 100% 0; } 50% { background-position: 0 0; } }
  .hero .lead { max-width: 36em; margin: 32px auto 0; text-wrap: balance; }
  .hero .actions { justify-content: center; }
  .caption { margin: 18px 0 0; color: var(--text-tertiary); font-size: 13px; letter-spacing: 0; }
  .caption a { color: var(--text-secondary); }
  .fade { animation: rise 1s var(--ease) both; animation-delay: var(--d); }
  @keyframes rise { from { opacity: 0; transform: translateY(0.4em); filter: blur(6px); } }
  @keyframes shine { 0%, 100% { background-position: 100% 0; } 50% { background-position: 0 0; } }

  .stage { margin-top: clamp(56px, 9vh, 96px); padding: 0 24px; }
  .frame {
    position: relative; margin: 0 auto; width: min(1200px, 100%);
    /* A graphite display bezel in both themes, so the video reads as a screen. */
    padding: 9px; border-radius: 30px;
    background: linear-gradient(180deg, #2c2c2f, #141416);
    box-shadow: inset 0 0.5px 0 rgba(255, 255, 255, 0.22), inset 0 0 0 0.5px rgba(255, 255, 255, 0.08), var(--shadow);
    animation: rise 1.2s var(--ease) 0.5s both;
  }
  .frame video { width: 100%; aspect-ratio: 16 / 9; border-radius: 22px; background: #000; object-fit: cover; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .frame { animation: grow linear both; animation-timeline: view(); animation-range: entry 10% cover 35%; }
      @keyframes grow { from { transform: scale(0.9); opacity: 0.4; } to { transform: scale(1); opacity: 1; } }
    }
  }
  .toggle {
    position: absolute; right: 24px; bottom: 24px; width: 36px; height: 36px; border-radius: 50%;
    display: grid; place-items: center; border: 0; cursor: pointer; color: #fff;
    background: rgba(30, 30, 32, 0.55); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.25); opacity: 0.75; transition: opacity 0.3s, transform 0.3s var(--ease);
  }
  .toggle:hover { opacity: 1; transform: scale(1.06); }
  .toggle svg { width: 14px; height: 14px; fill: currentColor; }
  .toggle .icon-play, .toggle.paused .icon-pause { display: none; }
  .toggle.paused .icon-play { display: block; }

  .points { list-style: none; padding: 0; margin: clamp(72px, 10vh, 120px) auto 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .points li { display: grid; gap: 8px; padding-top: 24px; box-shadow: 0 -0.5px 0 var(--border); }
  .index { font: 12px var(--mono); color: var(--accent); letter-spacing: 0.06em; margin-bottom: 10px; }
  .points strong { font-size: clamp(21px, 2.2vw, 24px); font-weight: 600; letter-spacing: -0.025em; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .points li { animation: rise linear both; animation-timeline: view(); animation-range: entry 0% entry 60%; }
    }
  }
  .points span:last-child { color: var(--text-secondary); font-size: 15px; }

  /* Plain, always-open answers: what a searcher came for is on the page. */
  .faq { margin: clamp(96px, 14vh, 160px) auto 0; max-width: 820px; }
  .faq h2 { font-size: clamp(32px, 4.4vw, 48px); text-align: center; margin-bottom: 40px; }
  .faq dl { margin: 0; display: grid; }
  .faq dl > div { display: grid; gap: 8px; padding: 24px 0; box-shadow: 0 -0.5px 0 var(--border); }
  .faq dt { font-size: clamp(18px, 1.9vw, 21px); font-weight: 600; letter-spacing: -0.02em; }
  .faq dd { margin: 0; color: var(--text-secondary); font-size: 16px; }

  @media (max-width: 700px) {
    .stage { padding: 0 16px; }
    .frame { padding: 6px; border-radius: 26px; }
    .frame video { aspect-ratio: 9 / 16; border-radius: 20px; }
    .toggle { right: 18px; bottom: 18px; }
    .points { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .word, .fade, .frame, .shine, .open-source::before { animation: none; }
  }
</style>
